# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Server-only. Bypasses Row Level Security — keep it secret.
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Public URL of the storefront (canonical links, sitemap, order links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret the admin panel sends as "Authorization: Bearer <secret>" to
# POST /api/revalidate after catalog edits. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=replace_with_a_long_random_string

# Cloudinary (product images)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# SSLCommerz online payment (bKash, Nagad, Rocket, cards…). Server-only — never
# prefix these with NEXT_PUBLIC_. Leave the store id/password empty to offer
# cash on delivery only. SSLCOMMERZ_SANDBOX=false switches to the live gateway.
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sslcommerz_store_password
SSLCOMMERZ_SANDBOX=true
